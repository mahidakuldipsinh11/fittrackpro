{
  "buildCommand": "cd mk/mk/Fittrack && npm install && npx vite build --base=/",
  "outputDirectory": "mk/mk/Fittrack/dist",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://fittrackpro-backend.onrender.com/api/:path*" },
    { "source": "/((?!assets/).*)", "destination": "/index.html" }
  ]
}